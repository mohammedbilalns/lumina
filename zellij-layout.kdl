layout {
  pane split_direction="horizontal" {
    pane name="frontend" {
      command "pnpm"
      args "--filter" "server" "start:dev"
      cwd "~/my_projects/machine_task1"
    }

    pane name="backend" {
      command "pnpm"
      args "--filter" "client" "dev"
      cwd "~/my_projects/machine_task1/server"
    }
  }
}
